{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=x86-64-v2",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v2",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_CROSS_CONFIGS": "all",
                "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
                "CMAKE_DEFAULT_CONFIGS": "all",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=x86-64-v2",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v2",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_CROSS_CONFIGS": "all",
                "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
                "CMAKE_DEFAULT_CONFIGS": "all",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "mac-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_CROSS_CONFIGS": "all",
                "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
                "CMAKE_DEFAULT_CONFIGS": "all",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_OSX_ARCHITECTURES": "x86_64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows-arm64-base",
            "hidden": true,
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a"
            }
        },
        {
            "name": "linux-arm64-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a"
            }
        },
        {
            "name": "mac-arm64-base",
            "hidden": true,
            "inherits": "mac-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a",
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
            "name": "win-amd64",
            "displayName": "Windows AMD64",
            "description": "Multi-config build for Windows AMD64 using Clang",
            "inherits": "windows-base"
        },
        {
            "name": "win-amd64-asan",
            "displayName": "Windows AMD64 ASan",
            "description": "AddressSanitizer build with tests; use the RelWithDebInfo configuration. Output goes to out/win-amd64-asan",
            "inherits": "windows-base",
            "cacheVariables": {
                "REXGLUE_SANITIZERS": "address",
                "REXGLUE_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "win-amd64-fuzz",
            "displayName": "Windows AMD64 libFuzzer",
            "description": "libFuzzer targets (tests/fuzz) with AddressSanitizer; use the RelWithDebInfo configuration. Output goes to out/win-amd64-asan-fuzz",
            "inherits": "windows-base",
            "cacheVariables": {
                "REXGLUE_SANITIZERS": "address",
                "REXGLUE_BUILD_FUZZERS": "ON",
                "REXGLUE_USE_VULKAN": "ON"
            }
        },
        {
            "name": "win-arm64",
            "displayName": "Windows ARM64",
            "description": "Multi-config build for Windows ARM64 using Clang",
            "inherits": "windows-arm64-base"
        },
        {
            "name": "linux-amd64",
            "displayName": "Linux AMD64",
            "description": "Multi-config build for Linux AMD64 using Clang",
            "inherits": "linux-base"
        },
        {
            "name": "linux-amd64-asan",
            "displayName": "Linux AMD64 ASan+UBSan",
            "description": "AddressSanitizer (with LeakSanitizer) and UBSan build with tests. Output goes to out/linux-amd64-asan-ubsan",
            "inherits": "linux-base",
            "cacheVariables": {
                "REXGLUE_SANITIZERS": "address,undefined",
                "REXGLUE_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "linux-arm64",
            "displayName": "Linux ARM64",
            "description": "Multi-config build for Linux ARM64 using Clang",
            "inherits": "linux-arm64-base"
        },
        {
            "name": "mac-amd64",
            "displayName": "macOS AMD64",
            "description": "Multi-config build for macOS AMD64 using Clang",
            "inherits": "mac-base"
        },
        {
            "name": "mac-arm64",
            "displayName": "macOS ARM64",
            "description": "Multi-config build for macOS ARM64 using Clang",
            "inherits": "mac-arm64-base"
        }
    ],
    "buildPresets": [
        {
            "name": "win-amd64-debug",
            "configurePreset": "win-amd64",
