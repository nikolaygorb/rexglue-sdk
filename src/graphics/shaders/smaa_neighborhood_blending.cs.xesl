#include "smaa.xesli"

entry_bindings_begin_compute_xe
  push_const_binding_xe(buffer(0))
  entry_binding_next_xe
  texture_xe(texture_2d_xe, xe_smaa_color, set=1, binding=0, t0, space0,
             texture(0))
  entry_binding_next_xe
  texture_xe(texture_2d_xe, xe_smaa_weights, set=1, binding=1, t1, space0,
             texture(1))
  entry_binding_next_xe
  image_wo_xe(image_2d_xe, image_format_rgb10_a2_xe, xe_smaa_dest, set=2,
              binding=0, u0, space0, texture(2))
entry_bindings_end_inputs_begin_compute_xe
  entry_in_global_thread_id_xe
entry_inputs_end_code_begin_compute_xe
  uint2_xe pixel = in_global_thread_id_xe.xy;
  dont_flatten_xe
  if (any(greater_than_equal_xe(pixel, push_const_xe(xe_smaa_size)))) {
    return;
  }
  float2_xe texcoord = XeSmaaTexcoord(pixel);
  float4_xe offset;
  SMAANeighborhoodBlendingVS(texcoord, offset);
  float4_xe color = SMAANeighborhoodBlendingPS(texcoord, offset, xe_smaa_color,
                                               xe_smaa_weights);
  image_store_2d_rgba_xe(xe_smaa_dest, pixel, float4_xe(color.rgb, 1.0));
entry_code_end_compute_xe
